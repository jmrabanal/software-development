public class TwoDim_Arrays {
    public static void main(String[] args) {

        int i, j;
        int size = 5;
        int elements[][] = new int[size][size];

        //randomizing
        System.out.println("1. Output the array elements ");
        System.out.println("The array elements are: ");
        for (i = 0; i < size; i++) {
            for (j = 0; j < size; j++) {
                elements[i][j] = (int) (Math.random() * 10);
                System.out.print(elements[i][j] + " ");
            }
            System.out.println();
        }

        //sum of each row
        System.out.println("2. Output the sum of each row");
        for(i = 0; i < size; i++) {
            int sumofrow = 0;
            for (j = 0; j < size; j++) {
                sumofrow += elements[i][j];
            }
            System.out.println("The sum of this row " + (i + 1) + "  is: " + sumofrow);
        }

        //sum of each column
        System.out.println("3. Output the sum of each column");
        for(j = 0; j < size; j++) {
            int sumofcolumn = 0;
            for (i = 0; i < size; i++) {
                sumofcolumn += elements[i][j];
            }
            System.out.println("The sum of this column " + (j + 1) + "  is: " + sumofcolumn);
        }

        int sumofall = 0, sumofprime = 0, sumofdiag = 0, sumofbelow = 0, sumofabove = 0;
        String elementsabove = "", elementsbelow = "";
        int sumofbelowdiag = 0, sumofabovediag = 0;

        //sum of each column
        for(i = 0; i < size; i++) {
            for(j = 0; j < size; j++) {
                int val = elements[i][j];

                sumofall += val;

                //prime numbers
                if (val == 2 || val == 3 || val == 5 || val == 7) {
                    sumofprime += val;
                }
                //sum of diagonal
                if (i == j) {
                    sumofdiag += val;
                }
                //sum of elements below diagonal
                if (i > j) {
                    elementsbelow += val + " ";
                    sumofbelow += val;
                    //for odd
                    if (val % 2 != 0) {
                        sumofbelowdiag += val;
                    }
                    }
                if (i < j) {
                    elementsabove += val + " ";
                    sumofabove += val;
                    //for even
                    if (val % 2 == 0) {
                        sumofabovediag += val;
                    }
                }
            }
        }

        System.out.println("4. Output the sum of all elements");
        System.out.println("The sum of all elements  is: " + sumofall);

        System.out.println("5. Output the sum of all prime numbers");
        System.out.println("The sum of all prime elements  is: " + sumofprime);

        System.out.println("6. Output the sum of elements in the main diagonal");
        System.out.println("The sum of the main diagonal is: " + sumofdiag);

        System.out.println("7. Output the sum of the elements below the diagonal.");
        System.out.println("The sum of the elements below the diagonal are: " + sumofbelow);

        System.out.println("8. Output the sum of the elements above diagonal.");
        System.out.println("The sum of the elements above the diagonal are: " + sumofabove);

        System.out.println("9. Output the sum of odd numbers below the diagonal.");
        System.out.println("The sum of odd numbers below the diagonal is: " + sumofbelowdiag);

        System.out.println("10. Output the sum of even numbers above the diagonal.");
        System.out.println("The sum of even numbers above the diagonal is: " + sumofabovediag);
    }
}
